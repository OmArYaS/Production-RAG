# Hybrid Document & Knowledge Assistant — Zero-cost local stack.
# No paid APIs, no cloud vector DBs.

# --- Embedding (DEDICATED local model; NEVER the chat LLM) ---
EMBEDDING_PROVIDER=local              # "local" (fastembed/sentence-transformers) | "ollama"
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # default model for the local embedding adapter
OLLAMA_EMBED_MODEL=nomic-embed-text     # used when EMBEDDING_PROVIDER=ollama (via /api/embeddings)

# --- Chat LLM (model-agnostic local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_k_m  # swapable: gemma2, deepseek-r1, llama3.1, ...

# --- Vector index ---
VECTOR_INDEX_PATH=.data/vector_index.json
VECTOR_BACKEND=auto                     # "auto" | "faiss" | "local"

# --- SQLite persistence (documents, chunks, Q&A history) ---
DATABASE_URL=sqlite:///.data/rag.db

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K=10
